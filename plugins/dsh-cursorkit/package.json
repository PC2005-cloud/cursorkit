{
  "name": "dsh-cursorkit",
  "version": "0.1.2",
  "type": "module",
  "description": "把 CursorKit 的光标动效铺进 DeepSeek Harness 的 Web 界面。",
  "license": "MIT",
  "homepage": "https://cursor.lxpavilion.top/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PC2005-cloud/cursorkit.git",
    "directory": "plugins/dsh-cursorkit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cursor",
    "cursor-effect",
    "web-components",
    "zero-dependency"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "cursorkit-effects": "^0.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-alpha.2": "unknown",
        "0.2.1-alpha.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.0-rc.1": "unknown",
        "0.1.7-rc.2": "unknown"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
