# 依赖
node_modules/

# 扩展构建产物（由 extension/npm run build 生成，不入库）
extension/dist/
extension/*.zip

# DSH 插件构建产物 lib/ 有意入库（不忽略）：
#   - DSH STORE 的固定 Commit 审计要求可分发面里的运行产物存在于仓库树，
#     缺失会被判 SUBMISSION_SCAN_INCOMPLETE 并失败关闭；
#   - 提交后仓库可从源码直接安装，免去重新构建。
# 改完源码记得重新 npm run build 并提交产物。

# 本地调试用的临时目录（探针、冒烟页、截图）
.probe/
.smoke/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
